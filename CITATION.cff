    family-names: Romanenko
    affiliation: "HSE University, Faculty of Computer Science"
    email: ""
keywords:
  - physics-informed neural networks
  - PINN
  - residual stress
  - wire drawing
  - finite element method
  - surrogate modeling
  - axisymmetric plasticity
