# ──────────────────────────────────────────────────────────────────────────
# Шаблон переменных окружения
# Скопировать в .env и заполнить значения. Файл .env в git не коммитится.
# ──────────────────────────────────────────────────────────────────────────

# Optuna storage (опционально, для распределённого подбора гиперпараметров)
# Если не задано — используется in-memory study
OPTUNA_STORAGE=sqlite:///optuna_study.db

# Weights & Biases (опционально, для трекинга экспериментов)
WANDB_API_KEY=
WANDB_PROJECT=pinn-wire-drawing
WANDB_ENTITY=

# Hugging Face токен (опционально, на случай выгрузки моделей в Hub)
HF_TOKEN=

# Путь к локальной копии данных (если данные лежат не в data/processed/)
DATA_DIR=./data/processed

# Устройство для обучения: cuda / cpu / mps
DEVICE=cuda

# Random seed для воспроизводимости
SEED=42
